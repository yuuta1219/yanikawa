---
// 管理画面。わざと飾りのない、手抜きの明るい画面（懐中電灯もない）
import { getCollection } from 'astro:content';
import { profile } from '../../data/profile';
import { renderAdmin } from '../../lib/admin';
import { adminPassword, seal } from '../../lib/vault';
import SiteMeta from '../../components/SiteMeta.astro';

const payload = await seal(
  renderAdmin({
    diary: await getCollection('diary'),
    drafts: await getCollection('drafts'),
    apps: await getCollection('apps'),
  }),
  adminPassword(),
);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>管理画面 - yanikawa</title>
    <SiteMeta title="管理画面" description="" ogp={false} />
  </head>
  <body>
    <div id="app">
      <form class="login" id="login">
        <h1>yanikawa 管理画面</h1>
        <label>
          メールアドレス
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <label>
          パスワード
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <p class="error" id="error" role="alert" hidden>メールアドレスまたはパスワードが違います</p>
        <button type="submit">ログイン</button>
      </form>
    </div>
    <script type="application/json" id="admin-data" is:inline set:html={JSON.stringify(payload)}></script>
    <script type="application/json" id="admin-mail" is:inline set:html={JSON.stringify(profile.mail)}></script>

    <script>
      import { unseal, type SealedPayload } from '../../lib/unseal';

      const KEY = 'yanikawa-admin';
      const app = document.getElementById('app')!;
      const form = document.getElementById('login') as HTMLFormElement;
      const error = document.getElementById('error')!;
      const payload: SealedPayload = JSON.parse(document.getElementById('admin-data')!.textContent!);
      const mail: string = JSON.parse(document.getElementById('admin-mail')!.textContent!);

      async function open(password: string) {
        try {
          app.innerHTML = await unseal(payload, password);
          document.title = 'ダッシュボード - yanikawa';
          return true;
        } catch {
          return false;
        }
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const email = String(data.get('email')).trim().toLowerCase();
        const password = String(data.get('password')).trim().toLowerCase();
        error.hidden = true;
        if (email === mail && (await open(password))) {
          try {
            sessionStorage.setItem(KEY, password);
          } catch {}
        } else {
          error.hidden = false;
        }
      });

      app.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('[data-logout]')) return;
        try {
          sessionStorage.removeItem(KEY);
        } catch {}
        location.reload();
      });

      // 「詳細」を押すと、AI が記事を爆速で自動生成しはじめ、画面が壊れ、ホームページに戻される
      const WORDS = ['サイトをつくった', '古本屋で', '雨の日曜日', '自己増幅', 'カードが使えない', '山に帰ろうかな', 'もうどうでもいい', 'こちらで書いておきます', 'ようこそ', 'yanikawa'];
      const GLYPHS = 'yanikawa■□▒01複製';
      const pick = <T,>(list: ArrayLike<T>) => list[Math.floor(Math.random() * list.length)];
      let running = false;

      function corruptText(times: number) {
        const walker = document.createTreeWalker(app, NodeFilter.SHOW_TEXT);
        const nodes: Text[] = [];
        while (walker.nextNode()) if ((walker.currentNode as Text).data.trim()) nodes.push(walker.currentNode as Text);
        for (let i = 0; i < times && nodes.length; i++) {
          const node = pick(nodes);
          const at = Math.floor(Math.random() * node.data.length);
          node.data = node.data.slice(0, at) + pick(GLYPHS) + node.data.slice(at + 1);
        }
      }

      function goo() {
        if (running) return;
        running = true;
        const rows = document.getElementById('diary-rows')!;
        const count = document.getElementById('diary-count')!;
        let n = rows.children.length;
        const start = performance.now();

        const grow = () => {
          const elapsed = performance.now() - start;
          const batch = 1 + Math.floor(elapsed / 300);
          for (let i = 0; i < batch; i++) {
            n = Math.floor(n * 1.04) + 1;
            const tr = document.createElement('tr');
            tr.innerHTML = `<td>${n}</td><td>${pick(WORDS)}（複製 #${n}）</td><td>2026.12.20</td><td><span class="status draft">自動生成</span></td><td><button type="button" disabled>詳細</button></td>`;
            rows.prepend(tr);
          }
          while (rows.children.length > 300) rows.lastElementChild!.remove();
          count.textContent = n.toLocaleString();
          if (elapsed > 2200) corruptText(Math.floor(elapsed / 200));
          if (elapsed < 7200) setTimeout(grow, Math.max(16, 140 - elapsed / 30));
        };
        grow();

        // だんだん壊れていく
        [
          [1600, 'goo-1'],
          [3200, 'goo-2'],
          [4800, 'goo-3'],
          [6400, 'goo-4'],
        ].forEach(([ms, cls]) => setTimeout(() => document.body.classList.add(cls as string), ms as number));

        setTimeout(() => {
          try {
            localStorage.setItem('yanikawa-flag:goo', String(Date.now()));
            localStorage.removeItem('yanikawa-goo-seen:about');
            localStorage.removeItem('yanikawa-goo-seen:diary');
          } catch {}
          location.href = '/home/';
        }, 7600);
      }

      app.addEventListener('click', (e) => {
        if ((e.target as Element).closest('[data-goo]')) goo();
      });

      // 同じタブで一度ログインしていれば、そのまま開く
      try {
        const saved = sessionStorage.getItem(KEY);
        if (saved) open(saved);
      } catch {}
    </script>

    <style is:global>
      body {
        margin: 0;
        background: #f3f4f6;
        color: #222;
        font-family: system-ui, -apple-system, 'Hiragino Sans', 'Yu Gothic', sans-serif;
        font-size: 14px;
        line-height: 1.6;
      }
      button { padding: 4px 12px; border: 1px solid #999; border-radius: 3px; background: #fff; font: inherit; cursor: pointer; }
      button:disabled { color: #999; cursor: default; }
      input, textarea { box-sizing: border-box; width: 100%; padding: 6px 8px; border: 1px solid #bbb; border-radius: 3px; background: #fff; font: inherit; }
      a { color: #1a5fd0; }

      .login { max-width: 320px; margin: 80px auto; padding: 24px; border: 1px solid #ddd; background: #fff; }
      .login h1 { margin: 0 0 16px; font-size: 18px; }
      .login label { display: block; margin-bottom: 12px; }
      .login button[type='submit'] { width: 100%; border-color: #1a5fd0; background: #1a5fd0; color: #fff; }
      .error { margin: 0 0 12px; color: #c00; }

      .bar { display: flex; align-items: center; gap: 16px; padding: 8px 16px; background: #333; color: #fff; }
      .bar .who { margin-left: auto; font-size: 12px; color: #ccc; }
      .wrap { max-width: 960px; margin: 0 auto; padding: 8px 16px 48px; }
      .tabs { margin: 12px 0; }
      .info { margin: 0 0 16px; font-size: 12px; color: #777; }
      h2 { margin: 28px 0 8px; font-size: 16px; }
      table { width: 100%; border-collapse: collapse; background: #fff; }
      th, td { padding: 6px 8px; border: 1px solid #ccc; text-align: left; vertical-align: top; }
      th { background: #eee; font-weight: normal; }
      td:first-child { width: 3em; color: #777; }
      td:nth-child(3) { white-space: nowrap; }
      td:last-child { white-space: nowrap; }
      summary { cursor: pointer; }
      details textarea { margin-top: 6px; font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
      .status { padding: 1px 6px; border: 1px solid #9c9; background: #efe; font-size: 12px; }
      .status.draft { border-color: #cc9; background: #ffe; }
      .form { padding: 12px; border: 1px solid #ccc; background: #fff; }
      .form label { display: grid; grid-template-columns: 9em 1fr; gap: 8px; margin-bottom: 8px; }
      .form span { padding-top: 6px; color: #555; }
      .form textarea { font-family: ui-monospace, Menlo, monospace; font-size: 12px; }
      /* グレイグー化：だんだん壊れていく */
      body { overflow-x: hidden; }
      .goo-1 table { animation: jitter .18s steps(2) infinite; }
      .goo-1 .bar { background: #522; }
      .goo-2 #app { filter: contrast(1.4) saturate(1.6); }
      .goo-2 table { transform: skewX(-4deg) translateX(10px); }
      .goo-2 tr:nth-child(3n) { transform: translateX(-24px); background: #fee; }
      .goo-2 tr:nth-child(7n) { transform: translateX(40px) scaleY(1.6); }
      .goo-2 h2, .goo-2 td { text-shadow: 3px 0 rgba(255, 0, 60, 0.6), -3px 0 rgba(0, 180, 255, 0.5); }
      .goo-3 #app { transform: rotate(1.5deg) scale(1.03); filter: contrast(2) hue-rotate(80deg) saturate(2); }
      .goo-3 body, body.goo-3 { background: repeating-linear-gradient(0deg, #ddd 0 2px, #bbb 2px 4px); }
      .goo-3 .wrap { animation: tear .12s steps(2) infinite; }
      body.goo-4 #app { filter: invert(1) contrast(3); }
      body.goo-4::after { content: ''; position: fixed; inset: 0; background: #000; animation: fade-black 1.1s ease forwards; }
      @keyframes jitter { 50% { transform: translate(2px, -1px); } }
      @keyframes tear { 50% { transform: translateX(-30px) skewX(8deg); } }
      @keyframes fade-black { from { opacity: 0; } to { opacity: 1; } }

      @media (max-width: 600px) {
        .form label { grid-template-columns: 1fr; gap: 2px; }
        .bar .who { display: none; }
        table { font-size: 12px; }
      }
    </style>
  </body>
</html>
