---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, published, ticketNumbers } from '../../utils';

export async function getStaticPaths() {
  const all = await getCollection('apps', published);
  const numbers = ticketNumbers(all);
  return all.map((entry) => ({ params: { id: entry.id }, props: { entry, no: numbers.get(entry.id) ?? 0 } }));
}

const { entry, no } = Astro.props;
const { Content } = await render(entry);
const { title, summary, url, repo, tags, emoji, date } = entry.data;
---
<Base title={title} description={summary}>
  <div class="read">
    <div class="ticket big">
      <div class="stub">
        <span class="label">余興券</span>
        <span class="no">No.{String(no).padStart(3, '0')}</span>
      </div>
      <div class="body">
        <div class="top">
          <span class="emoji">{emoji}</span>
          <span class="date">{formatDate(date)}</span>
        </div>
        <h1 class="title">{title}</h1>
        <p class="summary">{summary}</p>
        {tags.length > 0 && <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
      </div>
    </div>

    {(url || repo) && (
      <p class="actions">
        {url && <a class="btn" href={url} target="_blank" rel="noopener">使ってみる</a>}
        {repo && <a class="btn ghost" href={repo} target="_blank" rel="noopener">ソースコード</a>}
      </p>
    )}

    <div class="prose"><Content /></div>
    <nav class="pager"><a href="/apps/">← アプリ一覧へ</a></nav>
  </div>
</Base>

<style>
  .read { max-width: 42rem; margin: 1.5rem auto 0; }
  .big { --stub: 88px; margin-bottom: 2rem; }
  .big .body { padding: 1.6rem 1.8rem; }
  .big .emoji { font-size: 2.4rem; }
  .big .title { font-size: clamp(1.4rem, 4vw, 1.9rem); }
  .big .summary { font-size: .95rem; }
  .actions { display: flex; flex-wrap: wrap; gap: .8rem; margin: 0 0 3rem; }
</style>
