---
// 入口：明るい「やにかわのおうち」。扉をあけると、中の暗いサイトへ
import SiteMeta from '../components/SiteMeta.astro';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#bfe6ff" />
    <title>やにかわのおうち</title>
    <meta name="description" content="やにかわのおうちへようこそ！" />
    <SiteMeta title="やにかわのおうち" description="やにかわのおうちへようこそ！とびらをクリックしてね。" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Yusei+Magic&family=Zen+Maru+Gothic:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="sky" aria-hidden="true">
      <div class="sun"></div>
      <div class="cloud c1"></div>
      <div class="cloud c2"></div>
      <div class="cloud c3"></div>
    </div>

    <main>
      <p class="welcome">ようこそ！</p>
      <h1>やにかわのおうち</h1>
      <p class="hint">とびらを クリックしてね！<span class="arrow" aria-hidden="true">↓</span></p>

      <div class="house">
        <div class="chimney" aria-hidden="true"></div>
        <div class="roof" aria-hidden="true"></div>
        <div class="wall">
          <div class="window left" aria-hidden="true"></div>
          <div class="window right" aria-hidden="true"></div>
          <div class="doorway">
            <button type="button" class="door" aria-label="とびらをあけて、おうちに入る">
              <span class="plate">yanikawa</span>
              <span class="knob"></span>
            </button>
          </div>
        </div>
        <div class="step" aria-hidden="true"></div>
      </div>

      <div class="garden" aria-hidden="true">
        <span>🌷</span><span>🌼</span><span>🌱</span><span>🌷</span><span>🌼</span>
      </div>
    </main>

    <footer>since 2026 ・ © yanikawa</footer>

    <div class="fade" aria-hidden="true"></div>

    <script>
      const door = document.querySelector<HTMLButtonElement>('.door')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const enter = () => (location.href = '/home/?from=door');

      door.addEventListener('click', () => {
        if (reduce) return enter();
        door.disabled = true;
        document.body.classList.add('is-opening');
        setTimeout(() => document.body.classList.add('is-leaving'), 900);
        setTimeout(enter, 1900);
      });

      // 戻るボタンで帰ってきたとき、扉を閉じた状態に戻す
      addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        door.disabled = false;
        document.body.classList.remove('is-opening', 'is-leaving');
      });
    </script>
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    background: linear-gradient(180deg, #a9dcff 0%, #d7efff 45%, #fff6e2 100%);
    color: #6b4a3a;
    font-family: 'Zen Maru Gothic', system-ui, sans-serif;
    text-align: center;
  }
</style>

<style>
  /* 空 */
  .sky { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .sun {
    position: absolute;
    top: 6%;
    right: 8%;
    width: clamp(70px, 12vw, 120px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ffd65c;
    box-shadow: 0 0 0 14px rgba(255, 214, 92, 0.25), 0 0 60px 20px rgba(255, 214, 92, 0.45);
    animation: glow 4s ease-in-out infinite;
  }
  @keyframes glow { 50% { box-shadow: 0 0 0 22px rgba(255, 214, 92, 0.18), 0 0 80px 30px rgba(255, 214, 92, 0.5); } }
  .cloud {
    position: absolute;
    width: 120px;
    height: 36px;
    border-radius: 999px;
    background: #fff;
    opacity: .9;
    animation: drift linear infinite;
  }
  .cloud::before,
  .cloud::after { content: ''; position: absolute; border-radius: 50%; background: #fff; }
  .cloud::before { width: 54px; height: 54px; top: -26px; left: 18px; }
  .cloud::after { width: 40px; height: 40px; top: -18px; left: 60px; }
  .c1 { top: 12%; animation-duration: 60s; animation-delay: -10s; }
  .c2 { top: 28%; transform: scale(.7); animation-duration: 80s; animation-delay: -45s; }
  .c3 { top: 50%; transform: scale(.85); animation-duration: 70s; animation-delay: -25s; }
  @keyframes drift { from { left: -160px; } to { left: 110%; } }

  main {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(2.5rem, 7vh, 4.5rem) 16px 0;
  }

  .welcome {
    margin: 0;
    padding: .2rem 1rem;
    border-radius: 999px;
    background: #fff;
    color: #f08a6c;
    font-weight: 700;
    letter-spacing: .15em;
    box-shadow: 0 3px 0 #f5c9b8;
  }
  h1 {
    margin: .6rem 0 0;
    font-family: 'Yusei Magic', 'Zen Maru Gothic', sans-serif;
    font-weight: 400;
    font-size: clamp(2.2rem, 9vw, 4rem);
    letter-spacing: .08em;
    color: #f2836b;
    text-shadow: 3px 3px 0 #fff, -3px 3px 0 #fff, 3px -3px 0 #fff, -3px -3px 0 #fff, 0 6px 0 rgba(242, 131, 107, 0.25);
  }
  .hint { margin: 1rem 0 .4rem; font-weight: 700; font-size: 1.05rem; letter-spacing: .1em; color: #6b4a3a; }
  .arrow { display: block; margin-top: .2rem; color: #f2836b; animation: bounce 1.1s ease-in-out infinite; }
  @keyframes bounce { 50% { transform: translateY(6px); } }

  /* おうち */
  .house { position: relative; width: min(340px, 78vw); margin-top: 3.2rem; }
  .chimney {
    position: absolute;
    top: -30px;
    right: 18%;
    width: 13%;
    height: 110px;
    border-radius: 4px 4px 0 0;
    background: #c96a52;
  }
  .roof {
    position: relative;
    height: calc(min(340px, 78vw) * 0.42);
    margin: 0 -8%;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
    background: linear-gradient(180deg, #f59a7f, #ee7b5f);
  }
  .wall {
    position: relative;
    aspect-ratio: 1 / .78;
    border-radius: 0 0 10px 10px;
    background: #fff4dd;
    box-shadow: inset 0 -10px 0 #f6e3bf;
  }
  .window {
    position: absolute;
    top: 16%;
    width: 22%;
    aspect-ratio: 1;
    border: 5px solid #fff;
    border-radius: 8px;
    background:
      linear-gradient(#fff, #fff) center / 4px 100% no-repeat,
      linear-gradient(#fff, #fff) center / 100% 4px no-repeat,
      #ffe58f;
    box-shadow: 0 0 0 3px #e9cfa3;
  }
  .window.left { left: 10%; }
  .window.right { right: 10%; }

  .doorway {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 30%;
    height: 62%;
    transform: translateX(-50%);
    border-radius: 999px 999px 0 0;
    background: #0d0a08; /* 扉の奥は真っ暗 */
    perspective: 600px;
  }
  .door {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    border-radius: 999px 999px 0 0;
    background:
      repeating-linear-gradient(90deg, transparent 0 22%, rgba(0, 0, 0, 0.08) 22% 24%),
      linear-gradient(180deg, #c98a52, #b5733f);
    box-shadow: inset 0 0 0 4px #9c5f31;
    cursor: pointer;
    transform-origin: left center;
    transition: transform .9s cubic-bezier(.5, 0, .3, 1), filter .2s;
  }
  .door:hover { filter: brightness(1.08); }
  .door:focus-visible { outline: 3px solid #f2836b; outline-offset: 4px; }
  .plate {
    position: absolute;
    top: 22%;
    left: 50%;
    transform: translateX(-50%);
    padding: 1px 6px;
    border-radius: 4px;
    background: #fff4dd;
    font-size: clamp(.55rem, 2.2vw, .7rem);
    font-weight: 700;
    color: #9c5f31;
  }
  .knob {
    position: absolute;
    right: 14%;
    top: 55%;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ffd65c;
    box-shadow: 0 1px 0 #9c5f31;
  }
  .step { width: 40%; height: 10px; margin: 0 auto; border-radius: 0 0 6px 6px; background: #d9c3a0; }

  .garden { display: flex; justify-content: center; gap: clamp(.8rem, 4vw, 2rem); margin-top: -.2rem; font-size: 1.5rem; }
  .garden span:nth-child(odd) { transform: translateY(4px); }

  footer {
    position: relative;
    z-index: 1;
    padding: 2rem 0 1.4rem;
    margin-top: 1.5rem;
    background: #9fd77a;
    box-shadow: 0 -10px 0 #8bc866;
    font-size: .8rem;
    letter-spacing: .1em;
    color: #3f6b2b;
  }

  /* 扉があいて、暗闇に吸い込まれる */
  :global(body.is-opening) .door { transform: rotateY(-78deg); }
  :global(body.is-opening) .hint { opacity: 0; transition: opacity .3s; }
  .fade { position: fixed; inset: 0; z-index: 10; background: #040302; opacity: 0; pointer-events: none; transition: opacity 1s ease; }
  :global(body.is-leaving) .fade { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
