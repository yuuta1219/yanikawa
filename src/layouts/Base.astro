---
import '../styles/global.css';
import Lock from '../components/Lock.astro';
import { SITE, NAV } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = SITE.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} ― ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#13100d" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,400;1,500&family=Shippori+Mincho+B1:wght@400;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="lamp" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container bar">
        <a href="/" class="wordmark">{SITE.title}</a>
        <nav aria-label="メニュー">
          {NAV.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="fleuron" aria-hidden="true"><span></span></div>
        <div class="foot">
          <p class="copy">
            © {new Date().getFullYear()} {SITE.author}
            <a class="ember" href="/drawer/" data-drawer aria-label="引き出し"></a>
          </p>
          <p class="links">
            {SITE.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
          </p>
        </div>
      </div>
    </footer>

    <Lock />

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const lamp = document.querySelector<HTMLElement>('.lamp');
      if (lamp && !reduce) {
        addEventListener('pointermove', (e) => {
          lamp.style.setProperty('--mx', `${e.clientX}px`);
          lamp.style.setProperty('--my', `${e.clientY}px`);
        });
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.1 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(19, 16, 13, 0.84);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 64px; }
  .wordmark { font-family: var(--font-latin); font-style: italic; font-weight: 500; font-size: 1.7rem; line-height: 1; letter-spacing: .01em; color: var(--paper); }
  .wordmark:hover { color: var(--gold); }
  nav { display: flex; gap: clamp(1.1rem, 4vw, 2.2rem); font-family: var(--font-sans); font-size: .92rem; letter-spacing: .1em; }
  nav a { position: relative; padding: .4rem 0; color: var(--muted); }
  nav a:hover,
  nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: .1em; bottom: 0; height: 1px; background: var(--gold); }

  main { min-height: 70vh; padding: 1.5rem 0 5rem; }

  .site-footer { position: relative; z-index: 1; padding: 1rem 0 3rem; }
  .fleuron { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .fleuron::before,
  .fleuron::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--line-strong)); }
  .fleuron::after { transform: scaleX(-1); }
  .fleuron span { width: 7px; height: 7px; border: 1px solid var(--gold); transform: rotate(45deg); }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: .8rem;
    letter-spacing: .08em;
    color: var(--muted);
  }
  .foot p { display: flex; align-items: center; margin: 0; }
  .links { gap: 1.4rem; }
  .links a { color: var(--muted); }
  .links a:hover { color: var(--gold); }

  /* 足もとで小さく燻っている火種 */
  .ember { position: relative; width: 24px; height: 24px; margin-left: .3rem; border-radius: 50%; }
  .ember::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 5px;
    height: 5px;
    margin: auto;
    border-radius: 50%;
    background: #ffb35c;
    box-shadow: 0 0 6px 2px rgba(255, 140, 50, 0.5), 0 0 16px 4px rgba(255, 100, 30, 0.15);
    animation: smolder 4.5s ease-in-out infinite;
    transition: transform .3s;
  }
  .ember:hover::before { transform: scale(1.6); }
  @keyframes smolder { 0%, 100% { opacity: .5; } 50% { opacity: 1; } }

  @media (max-width: 420px) {
    .wordmark { font-size: 1.45rem; }
    nav { font-size: .86rem; letter-spacing: .06em; }
  }
</style>
