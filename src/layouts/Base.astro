---
import '../styles/global.css';
import Lock from '../components/Lock.astro';
import SiteMeta from '../components/SiteMeta.astro';
import { SITE, NAV } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = SITE.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} ― ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#13100d" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <SiteMeta title={pageTitle} description={description} ogp={!noindex} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;1,400;1,500&family=Shippori+Mincho+B1:wght@400;700;800&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Zen+Kurenaido&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
      // 扉から入ってきた最初の1回だけ、明るい状態から停電させる（?replay で何度でも）
      try {
        var q = new URLSearchParams(location.search);
        // ?reset で、すべてのフラグと演出の記録を消して最初からにする
        if (q.has('reset')) {
          Object.keys(localStorage)
            .filter(function (k) { return k.indexOf('yanikawa-') === 0; })
            .forEach(function (k) { localStorage.removeItem(k); });
          sessionStorage.clear();
          history.replaceState(null, '', location.pathname);
        }
        var root = document.documentElement;
        if (localStorage.getItem('yanikawa-flag:clear')) {
          // クリア後の世界：懐中電灯もフラグもない、明るいサイト
          root.classList.add('flag-clear');
        } else {
          var first = q.has('from') && !localStorage.getItem('yanikawa-lights-out');
          if ((first || q.has('replay')) && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.add('intro');
          }
          // 懐中電灯を消したままページを移ったら、消えたまま
          if (sessionStorage.getItem('yanikawa-light-off')) root.classList.add('lights-off');
          // 立っているフラグを html に付けておく（data-flag の中身が見えるようになる）
          if (localStorage.getItem('yanikawa-flag:request')) root.classList.add('flag-request');
          // 管理画面で「詳細」を押したあとは、サイトが侵食されている
          if (localStorage.getItem('yanikawa-flag:goo')) root.classList.add('flag-goo');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="torch" aria-hidden="true"></div>
    <div class="blackout" aria-hidden="true"></div>
    <button type="button" class="flashlight" aria-pressed="true" aria-label="懐中電灯を消す">
      <svg viewBox="0 0 120 120" width="96" height="96" overflow="visible" aria-hidden="true">
        <defs>
          <linearGradient id="fl-body" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#5a4f45" />
            <stop offset=".45" stop-color="#2c2520" />
            <stop offset="1" stop-color="#161210" />
          </linearGradient>
          <linearGradient id="fl-beam" x1="1" y1="0" x2="0" y2="0">
            <stop offset="0" stop-color="#ffe2a8" stop-opacity=".35" />
            <stop offset="1" stop-color="#ffe2a8" stop-opacity="0" />
          </linearGradient>
          <radialGradient id="fl-lens" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="#fffaf0" />
            <stop offset=".6" stop-color="#ffd98a" />
            <stop offset="1" stop-color="#e8a24a" />
          </radialGradient>
        </defs>
        <!-- 左上（画面の中心）を照らすように傾けた懐中電灯 -->
        <g transform="rotate(38 60 60)">
          <polygon class="beam" points="18,52 -60,22 -60,98 18,68" fill="url(#fl-beam)" />
          <rect x="44" y="49" width="62" height="22" rx="5" fill="url(#fl-body)" stroke="#0c0a08" />
          <rect x="74" y="49" width="2.5" height="22" fill="#0c0a08" opacity=".6" />
          <rect x="81" y="49" width="2.5" height="22" fill="#0c0a08" opacity=".6" />
          <rect x="88" y="49" width="2.5" height="22" fill="#0c0a08" opacity=".6" />
          <rect x="56" y="45.5" width="10" height="5" rx="1.5" fill="#d1a85a" />
          <path d="M44 49 L26 42 Q20 60 26 78 L44 71 Z" fill="url(#fl-body)" stroke="#0c0a08" />
          <ellipse class="lens" cx="23" cy="60" rx="5" ry="18" fill="url(#fl-lens)" />
        </g>
      </svg>
    </button>

    <header class="site-header">
      <div class="container bar">
        <a href="/home/" class="wordmark">{SITE.title}</a>
        <nav aria-label="メニュー">
          {NAV.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="fleuron" aria-hidden="true"><span></span></div>
        <div class="foot">
          <p class="copy">
            © {new Date().getFullYear()} {SITE.author}
          </p>
          <p class="links">
            {SITE.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
          </p>
        </div>
      </div>
    </footer>

    <Lock />

    <script>
      // 懐中電灯：マウス・指・キーボードで選んだ場所を照らす
      const torch = document.querySelector<HTMLElement>('.torch')!;
      let last = { x: innerWidth / 2, y: innerHeight * 0.4 };
      const aim = (x: number, y: number) => {
        last = { x, y };
        torch.style.setProperty('--mx', `${x}px`);
        torch.style.setProperty('--my', `${y}px`);
      };
      addEventListener('pointermove', (e) => aim(e.clientX, e.clientY), { passive: true });
      addEventListener('pointerdown', (e) => aim(e.clientX, e.clientY), { passive: true });
      // 停電：ぷつぷつ点滅して真っ暗 → 手元の灯りだけが残る
      const root = document.documentElement;
      const blackout = document.querySelector<HTMLElement>('.blackout')!;
      if (root.classList.contains('intro')) {
        setTimeout(() => blackout.classList.add('is-flickering'), 1400);
        blackout.addEventListener(
          'animationend',
          () => {
            blackout.style.opacity = '1';
            blackout.classList.remove('is-flickering');
            root.classList.remove('intro');
            void blackout.offsetWidth;
            blackout.style.transition = 'opacity 1.6s ease .5s';
            blackout.style.opacity = '0';
            try {
              localStorage.setItem('yanikawa-lights-out', '1');
            } catch {}
            history.replaceState(null, '', location.pathname);
          },
          { once: true },
        );
      }

      // 懐中電灯のスイッチ。いつでも消せる
      const flashlight = document.querySelector<HTMLButtonElement>('.flashlight')!;
      const setLight = (on: boolean) => {
        root.classList.toggle('lights-off', !on);
        flashlight.setAttribute('aria-pressed', String(on));
        flashlight.setAttribute('aria-label', on ? '懐中電灯を消す' : '懐中電灯をつける');
        dispatchEvent(new CustomEvent('yanikawa:light', { detail: on }));
        try {
          if (on) sessionStorage.removeItem('yanikawa-light-off');
          else sessionStorage.setItem('yanikawa-light-off', '1');
        } catch {}
      };
      setLight(!root.classList.contains('lights-off'));

      // data-read の場所を照らしてしばらく読んだあとに懐中電灯を触ると、フラグが立つ
      const read = new Set<string>();
      const dwell = new Map<HTMLElement, number>();
      const watched = [...document.querySelectorAll<HTMLElement>('[data-read]')];
      if (watched.length) {
        setInterval(() => {
          if (root.classList.contains('lights-off') || root.classList.contains('intro')) return;
          for (const el of watched) {
            const r = el.getBoundingClientRect();
            const inside = last.x >= r.left && last.x <= r.right && last.y >= r.top - 24 && last.y <= r.bottom + 24;
            const ms = inside ? (dwell.get(el) ?? 0) + 200 : 0;
            dwell.set(el, ms);
            if (ms >= 800) read.add(el.dataset.read!);
          }
        }, 200);
      }

      flashlight.addEventListener('click', () => {
        for (const flag of read) {
          try {
            localStorage.setItem(`yanikawa-flag:${flag}`, '1');
          } catch {}
          root.classList.add(`flag-${flag}`);
          dispatchEvent(new CustomEvent('yanikawa:flag', { detail: flag }));
        }
        read.clear();
        setLight(root.classList.contains('lights-off'));
      });

      // 侵食：自動生成の日記が増え、文字が少しずつ書き換わっていく
      if (root.classList.contains('flag-goo')) {
        // 侵食されたあとに開いたページを覚えておく（自己紹介と日記を見ると、元に戻すボタンが出る）
        try {
          if (location.pathname.startsWith('/about/')) localStorage.setItem('yanikawa-goo-seen:about', '1');
          if (location.pathname.startsWith('/diary/')) localStorage.setItem('yanikawa-goo-seen:diary', '1');
        } catch {}
        const GLYPHS = 'yanikawa■□▒01複製';
        const pick = <T,>(list: ArrayLike<T>) => list[Math.floor(Math.random() * list.length)];

        document.querySelectorAll<HTMLElement>('.entries').forEach((list) => {
          const first = list.querySelector('li');
          if (!first) return;
          for (let i = 0; i < 18; i++) {
            const copy = first.cloneNode(true) as HTMLElement;
            copy.removeAttribute('data-flag');
            const title = copy.querySelector('.t');
            if (title) title.textContent = `${title.textContent}（複製 #${Math.floor(Math.random() * 99999)}）`;
            const ex = copy.querySelector('.ex');
            if (ex) ex.textContent = 'こちらで書いておきます。'.repeat(1 + (i % 4));
            list.prepend(copy);
          }
        });
        const wordmark = document.querySelector('.wordmark');
        if (wordmark) wordmark.textContent = 'yanikawayanikawayanika';
        document.querySelectorAll('.copy').forEach((el) => (el.textContent = '© 2026–∞ yanikawa (bot)'));
        document.title = 'yanikawa yanikawa yanikawa yanikawa';

        const main = document.querySelector('main')!;
        let changes = 0;
        const erode = setInterval(() => {
          const walker = document.createTreeWalker(main, NodeFilter.SHOW_TEXT);
          const nodes: Text[] = [];
          while (walker.nextNode()) {
            const node = walker.currentNode as Text;
            // data-keep の中（元に戻すボタンやクリア画面）は壊さない
            if (node.data.trim() && !node.parentElement?.closest('[data-keep]')) nodes.push(node);
          }
          if (!nodes.length || ++changes > 900 || !root.classList.contains('flag-goo')) return clearInterval(erode);
          const node = pick(nodes);
          const at = Math.floor(Math.random() * node.data.length);
          node.data = node.data.slice(0, at) + pick(GLYPHS) + node.data.slice(at + 1);
        }, 120);
      }

      addEventListener('focusin', (e) => {
        const target = e.target as Element;
        if (!(target instanceof HTMLElement) || target.closest('#lock') || target === flashlight) return;
        const r = target.getBoundingClientRect();
        aim(r.left + r.width / 2, r.top + r.height / 2);
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        },
        { threshold: 0.1 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgba(19, 16, 13, 0.84);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 64px; }
  .wordmark { font-family: var(--font-latin); font-style: italic; font-weight: 500; font-size: 1.7rem; line-height: 1; letter-spacing: .01em; color: var(--paper); }
  .wordmark:hover { color: var(--gold); }
  nav { display: flex; gap: clamp(1.1rem, 4vw, 2.2rem); font-family: var(--font-sans); font-size: .92rem; letter-spacing: .1em; }
  nav a { position: relative; padding: .4rem 0; color: var(--muted); }
  nav a:hover,
  nav a[aria-current='page'] { color: var(--text); }
  nav a[aria-current='page']::after { content: ''; position: absolute; left: 0; right: .1em; bottom: 0; height: 1px; background: var(--gold); }

  main { min-height: 70vh; padding: 1.5rem 0 5rem; }

  .site-footer { position: relative; z-index: 1; padding: 1rem 0 3rem; }
  .fleuron { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
  .fleuron::before,
  .fleuron::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, var(--line-strong)); }
  .fleuron::after { transform: scaleX(-1); }
  .fleuron span { width: 7px; height: 7px; border: 1px solid var(--gold); transform: rotate(45deg); }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: .8rem;
    letter-spacing: .08em;
    color: var(--muted);
  }
  .foot p { display: flex; align-items: center; margin: 0; }
  .links { gap: 1.4rem; }
  .links a { color: var(--muted); }
  .links a:hover { color: var(--gold); }

  /* 足もとで小さく燻っている火種 */
  .ember { position: relative; width: 24px; height: 24px; margin-left: .3rem; border-radius: 50%; }
  .ember::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 5px;
    height: 5px;
    margin: auto;
    border-radius: 50%;
    background: #ffb35c;
    box-shadow: 0 0 6px 2px rgba(255, 140, 50, 0.5), 0 0 16px 4px rgba(255, 100, 30, 0.15);
    animation: smolder 4.5s ease-in-out infinite;
    transition: transform .3s;
  }
  .ember:hover::before { transform: scale(1.6); }
  @keyframes smolder { 0%, 100% { opacity: .5; } 50% { opacity: 1; } }

  @media (max-width: 420px) {
    .wordmark { font-size: 1.45rem; }
    nav { font-size: .86rem; letter-spacing: .06em; }
  }
</style>
