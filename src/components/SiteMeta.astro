---
// ファビコンと、SNS でシェアしたときのカード（OGP）
interface Props {
  title: string;
  description: string;
  ogp?: boolean;
}
const { title, description, ogp = true } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.jpg', Astro.site);
---
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{ogp && (
  <>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="やにかわのおうち" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="山の家の縁側で、のんびりくつろぐやにかわ" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@yanikawa_runteq" />
  </>
)}
