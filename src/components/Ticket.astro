---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils';

// アプリの半券カード。disabled のときは押せない（工事中）
interface Props {
  app: CollectionEntry<'apps'>;
  no?: number;
  tags?: boolean;
  disabled?: boolean;
}
const { app, no = 0, tags = false, disabled = false } = Astro.props;
const { title, summary, emoji, date } = app.data;
const Tag = disabled ? 'div' : 'a';
---
<Tag class:list={['ticket', { disabled }]} href={disabled ? undefined : `/apps/${app.id}/`} aria-disabled={disabled ? 'true' : undefined}>
  <span class="stub">
    <span class="label">余興券</span>
    <span class="no">No.{String(no).padStart(3, '0')}</span>
  </span>
  <span class="body">
    <span class="top">
      <span class="emoji">{emoji}</span>
      <span class="date">{formatDate(date)}</span>
    </span>
    <span class="title">{title}</span>
    <span class="summary">{summary}</span>
    {tags && app.data.tags.length > 0 && (
      <span class="tags">{app.data.tags.map((t) => <span class="tag">{t}</span>)}</span>
    )}
  </span>
</Tag>
