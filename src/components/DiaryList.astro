---
import type { CollectionEntry } from 'astro:content';
import { excerpt, formatMonthDay, weekday } from '../utils';

interface Props {
  entries: CollectionEntry<'diary'>[];
}
const { entries } = Astro.props;
---
<ul class="entries">
  {entries.map((d) => (
    <li>
      <a href={`/diary/${d.id}/`}>
        <span class="when">
          <span class="md">{formatMonthDay(d.data.date)}</span>
          <span class="wd">{weekday(d.data.date)}{d.data.weather && `・${d.data.weather}`}</span>
        </span>
        <span class="what">
          <span class="t">{d.data.title}</span>
          <span class="ex">{excerpt(d.body)}</span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .entries { list-style: none; margin: 0; padding: 0; }
  li + li { border-top: 1px solid var(--line); }
  a {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.4rem;
    margin: 0 -.8rem;
    padding: 1.2rem .8rem;
    border-radius: 2px;
    color: var(--text);
    transition: background .25s;
  }
  a:hover { background: rgba(209, 168, 90, 0.06); color: var(--text); }
  .when { display: flex; flex-direction: column; padding-top: .15rem; line-height: 1.25; }
  .md { font-family: var(--font-latin); font-size: 1.55rem; letter-spacing: .02em; color: var(--gold); }
  .wd { margin-top: .35rem; font-family: var(--font-sans); font-size: .75rem; letter-spacing: .1em; color: var(--muted); }
  .what { display: flex; flex-direction: column; gap: .3rem; min-width: 0; }
  .t { font-size: 1.1rem; font-weight: 700; letter-spacing: .06em; transition: color .25s; }
  a:hover .t { color: var(--gold); }
  .ex { font-family: var(--font-sans); font-size: .88rem; line-height: 1.8; color: var(--muted); }

  @media (max-width: 560px) {
    a { grid-template-columns: 4.2rem 1fr; gap: 1rem; }
    .md { font-size: 1.3rem; }
  }
</style>
